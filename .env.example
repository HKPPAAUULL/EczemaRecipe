# Copy to .env and replace with real credentials. .env is git-ignored — never commit it.
# These are DUMMY values for documentation only.

POSTGRES_USER=eczema
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=eczema_recipe

# App connection string. Inside docker-compose the DB host is `db`;
# for running the importer/tests on the host machine use 127.0.0.1 instead.
DATABASE_URL=postgresql://eczema:change_me_dev_only@db:5432/eczema_recipe
# DATABASE_URL=postgresql://eczema:change_me_dev_only@127.0.0.1:5432/eczema_recipe

# Optional ports (defaults shown)
# DB_PORT=5432
# API_PORT=8000

# Optional: enables pytest integration tests against a running DB
# TEST_DATABASE_URL=postgresql://eczema:change_me_dev_only@127.0.0.1:5432/eczema_recipe

# App behaviour
# APP_ENV: development | production | test (app refuses to start on any other value)
APP_ENV=development
# INCLUDE_DRAFTS=true shows unreviewed draft ingredients (dev only).
# MUST be false in production — the app refuses to start with APP_ENV=production + true.
INCLUDE_DRAFTS=true
# Comma-separated CORS origins for the frontend; empty = no CORS middleware
# CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js)
# WEB_PORT: host port for the site (default 3000)
# API_BASE_URL: used by the Next.js server to reach the backend;
#   inside docker-compose this is http://api:8000 — for `npm run dev`
#   on the host use http://127.0.0.1:8000 instead.
# WEB_PORT=3000
# API_BASE_URL=http://127.0.0.1:8000

# Admin review UI /admin password (>=16 chars; empty = disabled, /admin returns 404).
# Local/LAN only - never expose through Cloudflare Tunnel. Never commit a real value.
ADMIN_TOKEN=

# Production site URL (canonical/OG metadata); set to https://your-domain
# SITE_URL=http://localhost:3000

# Cloudflare Tunnel token (from Zero Trust dashboard); keep empty unless using --profile tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
